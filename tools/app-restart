#!/usr/bin/env bash
# app-restart NAME - restart one app. Part of the name is enough.
set -euo pipefail
source /DATA/scripts/tools/_common.sh
[[ $# -ge 1 ]] || fail "Use: app-restart <name>   (names: apps)"
as_root "$@"
c=$(find_container "$1")
ask "Restart $c?" || { say "Nothing changed."; exit 0; }
docker restart "$c" >/dev/null
sleep 2
docker ps -a --filter "name=^${c}$" --format '{{.Names}}: {{.Status}}'
